# Copy to .env and fill these in when you need them. The app does not use them
# until you call the lib/ helpers.
#
# Generate the data key with:
#   php -r 'echo sodium_bin2base64(sodium_crypto_aead_xchacha20poly1305_ietf_keygen(), SODIUM_BASE64_VARIANT_ORIGINAL), "\n";'
TECHCORP_HMAC_KEY=
TECHCORP_DATA_KEY=
